<%- include('partials/head') %>

<body class="bg-gray-100 min-h-screen flex flex-col">

  <%- include('partials/nav') %>

  <main class="flex-1 flex justify-center items-center px-4">

    <div class="bg-white p-8 rounded-2xl shadow-md w-full max-w-md">

      <h1 class="text-2xl font-bold text-gray-800 mb-4">
        Register Your Home
      </h1>

      <form action="/host/add-home" method="POST" class="space-y-4">

        <input
          type="text"
          name="houseName"
          placeholder="Enter home name"
          class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-pink-500 outline-none"
        />

        <button
          type="submit"
          class="w-full bg-pink-500 text-white py-3 rounded-lg hover:bg-pink-600 transition"
        >
          Submit
        </button>

      </form>

    </div>

  </main>

</body>
</html>