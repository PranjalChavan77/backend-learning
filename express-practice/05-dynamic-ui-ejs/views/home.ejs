<%- include('partials/head') %>
<%- include('partials/nav') %>
</head>
<body class="bg-gray-50">
  <%- include('partials/heroSection') %>
  <main class="max-w-6xl mx-auto px-4 pb-12 ">
    <section class="bg-pink-100 rounded-2xl shadow-lg p-8 border border-pink-500">

      <h2 class="text-3xl font-bold text-pink-600 mb-8 text-center">
       Registered Homes
      </h2>
      
      <% if (homesRegistered.length === 0) { %>
        <div class="text-center py-6">
          <p class="text-gray-600 text-lg">
            No homes registered yet.
          </p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% for(const home of homesRegistered) { %>
            <div class="bg-pink-400 rounded-xl shadow-md p-5 hover:shadow-xl transition duration-300">
              <h3 class="text-xl font-bold text-center text-black-800">
                <%= home.houseName %>
              </h3>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
  </main>

</body>
</html>