<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-gray-100">
    <%- include('../partials/nav') %>

    <main class="max-w-xl mx-auto mt-10 mb-16 px-4">
      <div class="bg-white p-8 rounded-2xl shadow-md w-full max-w-lg mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">
          Register Your Home
        </h1>

        <form action="/admin/add-home" method="POST" class="space-y-5">
          <div>
            <label class="block mb-2 font-medium text-gray-700">
              Home Name
            </label>
            <input
              type="text"
              name="houseName"
              placeholder="Enter home name"
              class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-pink-500 outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 font-medium text-gray-700">
              Price Per Night
            </label>
            <input
              type="number"
              name="price"
              placeholder="₹1000"
              class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-pink-500 outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 font-medium text-gray-700">
              Location
            </label>
            <input
              type="text"
              name="location"
              placeholder="Mumbai"
              class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-pink-500 outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 font-medium text-gray-700"> Rating </label>
            <input
              type="number"
              step="0.1"
              min="1"
              max="5"
              name="rating"
              placeholder="4.8"
              class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-pink-500 outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 font-medium text-gray-700">
              Photo URL
            </label>
            <input
              type="text"
              name="photoUrl"
              placeholder="https://..."
              class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-pink-500 outline-none"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-pink-500 text-white py-3 rounded-lg font-semibold hover:bg-pink-600 transition"
          >
            Add Home
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
