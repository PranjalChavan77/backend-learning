<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-green-50 min-h-screen flex flex-col">
    <%- include('../partials/nav') %>

    <main class="flex-1 flex justify-center items-center px-4 py-12">
      <div
        class="bg-white p-10 rounded-3xl shadow-xl text-center w-full max-w-md border border-green-100"
      >
        <div class="text-6xl mb-4">🎉</div>

        <h1 class="text-3xl font-bold text-green-600 mb-3">
          Home Registered Successfully!
        </h1>

        <p class="text-gray-600 mb-8">
          Your property has been added to the Airbnb listings.
        </p>

        <div class="flex justify-center gap-4">
          <a
            href="/"
            class="px-6 py-3 bg-pink-500 text-white rounded-xl font-semibold hover:bg-pink-600 transition shadow-md"
          >
            View Homes
          </a>

          <a
            href="/host/add-home"
            class="px-6 py-3 bg-green-500 text-white rounded-xl font-semibold hover:bg-green-600 transition shadow-md"
          >
            Add Another
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
