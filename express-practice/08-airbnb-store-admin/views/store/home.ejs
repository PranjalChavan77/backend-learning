<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head') %>
</head>

<body class="bg-gray-50">

  <%- include('../partials/nav') %>

  <%- include('../partials/heroSection') %>

  <main class="max-w-6xl mx-auto px-4 pb-12">

    <section class="bg-pink-100 rounded-2xl shadow-lg p-8 border border-pink-500">

      <h2 class="text-3xl font-bold text-pink-600 text-center mb-8">
        Registered Homes
      </h2>

      <% if (homesRegistered.length === 0) { %>

        <div class="text-center py-8">
          <p class="text-gray-600 text-lg">
            No homes registered yet.
          </p>
        </div>

      <% } else { %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-cente">

          <% for (const home of homesRegistered) { %>

            <div class="bg-white rounded-2xl overflow-hidden border border-pink-100 shadow-lg hover:shadow-2xl transition duration-300">

              <img
                src="<%= home.photoUrl %>"
                alt="<%= home.houseName %>"
                class="w-full h-56 object-cover"
              >

              <div class="p-5">

                <h3 class="text-2xl font-bold text-pink-600 mb-2">
                  <%= home.houseName %>
                </h3>

                <p class="text-gray-600 mb-2">
                  📍 <%= home.location %>
                </p>

                <p class="text-yellow-500 font-semibold mb-4">
                  ⭐ <%= home.rating %>
                </p>

                <div class="flex justify-between items-center border-t pt-4">

                  <div>
                    <p class="text-2xl font-bold text-gray-800">
                      ₹<%= home.price %>
                    </p>
                    <span class="text-sm text-gray-500 font-normal">
                      / night
                    </span>
                  </div>

                </div>

                <button class="px-6 py-3 bg-pink-500 rounded-xl text-white font-semibold hover:bg-pink-600 transition">Book Now</button>

              </div>

            </div>

          <% } %>

        </div>

      <% } %>

    </section>

  </main>

</body>

</html>