<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <%- include('partials/nav') %>

    <main class="flex items-center justify-center px-6 py-16">
      <div
        class="bg-white rounded-3xl shadow-xl p-10 max-w-lg w-full text-center border border-pink-100"
      >
        <h1 class="text-8xl font-extrabold text-pink-500 mb-4">404</h1>

        <h2 class="text-3xl font-bold text-gray-800 mb-4">Page Not Found</h2>

        <p class="text-gray-600 text-lg mb-8">
          Oops! The page you're looking for doesn't exist or may have been
          moved.
        </p>

        <a
          href="/"
          class="inline-block bg-pink-500 text-white px-8 py-3 rounded-xl font-semibold hover:bg-pink-600 transition duration-300 shadow-md"
        >
          🏡 Back to Home
        </a>
      </div>
    </main>
  </body>
</html>
