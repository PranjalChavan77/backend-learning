<header class="bg-pink-500 shadow-md">
  <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">

    <a
      href="/"
      class="text-3xl font-bold text-white tracking-wide hover:text-pink-100 transition"
    >
      Airbnb
    </a>

    <nav class="flex items-center gap-8">

      <a
        href="/admin/add-home"
        class="<%= currentPage === 'addHome'
          ? 'text-white font-semibold border-b-2 border-white pb-1'
          : 'text-white font-medium hover:text-pink-100 transition' %>"
      >
        Add Home
      </a>

      <a
        href="/admin/adminHomeList"
        class="<%= currentPage === 'adminHomeList'
          ? 'text-white font-semibold border-b-2 border-white pb-1'
          : 'text-white font-medium hover:text-pink-100 transition' %>"
      >
        Admin Homes
      </a>

      <a
        href="/homeList"
        class="<%= currentPage === 'homeList'
          ? 'text-white font-semibold border-b-2 border-white pb-1'
          : 'text-white font-medium hover:text-pink-100 transition' %>"
      >
        Home List
      </a>

      <a
        href="/favouriteList"
        class="<%= currentPage === 'favouriteList'
          ? 'text-white font-semibold border-b-2 border-white pb-1'
          : 'text-white font-medium hover:text-pink-100 transition' %>"
      >
        Favourites
      </a>

      <a
        href="/bookings"
        class="<%= currentPage === 'bookings'
          ? 'text-white font-semibold border-b-2 border-white pb-1'
          : 'text-white font-medium hover:text-pink-100 transition' %>"
      >
        Bookings
      </a>

    </nav>

  </div>
</header>